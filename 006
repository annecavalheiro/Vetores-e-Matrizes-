/* 06 - Considere um vetor A com 11 elementos onde A1 < A2 < ... < A6 > A7 > A8 > ... > A11, ou seja, está ordenado em ordem crescente até o sexto elemento, e a partir desse elemento está ordenado em ordem decrescente. Dado o vetor da questão anterior, proponha um algoritmo para ordenar os elementos. */

#include <stdio.h>

/* --- Protótipos das Funções --- */
void lerVetor(int v[], int n);
void ordenarVetor(int v[], int n);
void imprimirVetor(int v[], int n);

int main() {
    int v[11];

    lerVetor(v, 11);
    ordenarVetor(v, 11);
    
    printf("Vetor ordenado:\n");
    imprimirVetor(v, 11);

    return 0;
}

/* --- Implementação das Funções --- */

// Lê n elementos do vetor
void lerVetor(int v[], int n) {
    for (int i = 0; i < n; i++) {
        scanf("%d", &v[i]);
    }
}

// Ordena o vetor em ordem crescente (Selection Sort simples)
void ordenarVetor(int v[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int menor = i;
        for (int j = i + 1; j < n; j++) {
            if (v[j] < v[menor]) {
                menor = j;
            }
        }
        // Troca os elementos de posição
        if (menor != i) {
            int temp = v[i];
            v[i] = v[menor];
            v[menor] = temp;
        }
    }
}

// Imprime os elementos do vetor
void imprimirVetor(int v[], int n) {
    for (int i = 0; i < n; i++) {
        printf("%d ", v[i]);
    }
    printf("\n");
}
