/* 09 - Faça um programa que leia um vetor de cinco posições para números reais e, depois, um código inteiro. Se o código for zero, finalize o programa; se for 1, mostre o vetor na ordem direta; se for 2, mostre o vetor na ordem inversa. Caso, o código for diferente de 1 e 2 escreva uma mensagem falando que o código é inválido. */

#include <stdio.h>

/* --- Protótipos das Funções --- */
void lerVetor(float v[], int n);
void imprimirDireta(float v[], int n);
void imprimirInversa(float v[], int n);

int main() {
    float v[5];
    int codigo;

    lerVetor(v, 5);
    scanf("%d", &codigo);

    if (codigo == 0) {
        return 0; // Finaliza o programa
    } else if (codigo == 1) {
        imprimirDireta(v, 5);
    } else if (codigo == 2) {
        imprimirInversa(v, 5);
    } else {
        printf("Codigo invalido\n");
    }

    return 0;
}

/* --- Implementação das Funções --- */

// Lê 5 números reais para o vetor
void lerVetor(float v[], int n) {
    for (int i = 0; i < n; i++) {
        scanf("%f", &v[i]);
    }
}

// Imprime os elementos do vetor na ordem original (direta)
void imprimirDireta(float v[], int n) {
    for (int i = 0; i < n; i++) {
        printf("%.2f ", v[i]);
    }
    printf("\n");
}

// Imprime os elementos do vetor do último para o primeiro (inversa)
void imprimirInversa(float v[], int n) {
    for (int i = n - 1; i >= 0; i--) {
        printf("%.2f ", v[i]);
    }
    printf("\n");
}
